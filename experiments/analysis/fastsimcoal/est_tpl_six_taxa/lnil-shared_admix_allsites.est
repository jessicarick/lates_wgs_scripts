// Priors and rules file
// *********************
[PARAMETERS]
//#isInt? #name #dist. #min #max
//all Ns are in number of haploid individuals
1	POP0	unif	1000	2e6	output
1	POP1	unif	1000	2e6	output
1	POP2	unif	1000	2e6	output
1	POP3	unif	1000	2e6	output
1	POP4	unif	1000	2e6	output
1	POP5	unif	1000	2e6	output
0	RSANC01	logunif	0.1	20	output
0	RSANC12	logunif	0.1	20	output
0	LTANC0	logunif	0.1	20	output
0	LTANC1	logunif	0.1	20	output
0	LTANC2	logunif	0.1	20	output
1	TIME1	unif	1000	1e6	hide
1	TIME2	unif	1000	1e6	hide
1	TIME3	unif	1000	1e6	hide
1	TIME5	unif	1000	1e6	hide
0	MIG12	logunif	1e-8	0.2	output
0	MIG21	logunif	1e-8	0.2	output
0	MIG14	logunif	1e-8	0.2	output
0	MIG41	logunif	1e-8	0.2	output
1	TDIVLT1LT2	unif	1000	2e6	output
1	TDIVLT3LT4	unif	1000	2e6	output

[RULES]

[COMPLEX PARAMETERS]
1 TADM12 = TDIVLT1LT2+TIME3 output
1 TADM14 = TDIVLT3LT4+TIME5 output

1 FIRSTADM = TADM12 %max% TADM14 hide
1 TDIVLTLT = FIRSTADM+TIME1 output
1 TDIVNILLT = TDIVLTLT+TIME2 output
